# Vorlage für die lokale .env-Datei.
#   cp .env.example .env
# Die echte .env ist in .gitignore und darf NIE committet werden.

# --- Allgemein -------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true

# --- Datenbank -------------------------------------------------------------
# Lokal (passt zu docker-compose.yml):
DATABASE_URL=postgresql+asyncpg://flugalarm:flugalarm@localhost:5432/flugalarm

# Später bei Supabase: Connection String aus dem Dashboard,
# Treiber-Präfix auf postgresql+asyncpg:// ändern.
# Beim Pooler im Transaction-Modus (Port 6543) zusätzlich:
# DATABASE_DISABLE_STATEMENT_CACHE=true
DATABASE_DISABLE_STATEMENT_CACHE=false

# --- Supabase Auth (M2) ----------------------------------------------------
# Beides steht im Supabase-Dashboard unter
#   Project Settings → API  (Project URL bzw. JWT Secret).
# Ohne JWT_SECRET antwortet jeder geschützte Endpunkt mit HTTP 500 —
# der /health-Endpunkt bleibt davon unberührt.
# SUPABASE_URL wird nur für die Prüfung des Ausstellers (`iss`) gebraucht;
# leer lassen ist erlaubt, dann entfällt genau diese Prüfung.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# --- Amadeus (M5) ----------------------------------------------------------
# Konto auf developers.amadeus.com, dort eine Self-Service-App anlegen.
# Ohne Zugangsdaten läuft alles außer der echten Suche — die Tests benutzen
# eine gespeicherte Antwort und brauchen kein Netz.
# Achtung: Die Test-Umgebung liefert echte Strukturen, aber veraltete Preise.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- Prüflauf / Worker (M6) ------------------------------------------------
# Wie oft der Worker nachsieht, welche Alarme fällig sind (Minuten). Wie oft
# ein einzelner Alarm geprüft wird, steht dagegen am Alarm selbst
# (check_interval_minutes, Standard 360 = 6 Stunden).
PRUFLAUF_INTERVALL_MINUTEN=5

# Höchstens so viele Alarme pro Durchgang — schützt das Amadeus-Kontingent.
PRUFLAUF_MAX_ALARME_PRO_LAUF=20

# ===========================================================================
# Ab hier: noch NICHT nötig. Erst ausfüllen, wenn der Meilenstein ansteht.
# Nur zur Erinnerung, was am Ende gebraucht wird.
# ===========================================================================

# --- Web-Push / VAPID (M8) -------------------------------------------------
# Kein Apple-Konto, keine 99 EUR: Das Schluesselpaar erzeugst du selbst mit
#     uv run python -m scripts.vapid_schluessel
# und traegst die zwei ausgegebenen Zeilen hier ein. NUR EINMAL erzeugen —
# ein neues Paar macht alle bestehenden Geraete-Anmeldungen wertlos.
# Fehlen die Werte, laeuft alles weiter, es geht nur keine Push raus.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Kontaktadresse fuer den Push-Dienst (Pflicht laut Standard, mailto: oder https:)
# VAPID_SUBJECT=mailto:du@example.org

# Bremsen gegen Nachrichten-Spam (Standardwerte in config.py):
# PUSH_ABKUEHLPHASE_STUNDEN=6
# PUSH_MINDEST_VERBESSERUNG_PROZENT=5.0

# --- Anthropic / Claude (M10) ----------------------------------------------
# Schluessel von console.anthropic.com (Guthaben aufladen nicht vergessen).
# Fehlt er, laeuft alles weiter: Die Benachrichtigung wird dann vom fest
# programmierten deutschen Satz-Baukasten formuliert statt von Claude.
# Der Schluessel gehoert NUR hierher — nie ins Repository, nie in web/.
# ANTHROPIC_API_KEY=

# Standardwerte stehen in config.py; nur setzen, wenn du abweichen willst.
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_TIMEOUT_SECONDS=8.0
# ANTHROPIC_MAX_RETRIES=1
# ANTHROPIC_MAX_TOKENS=300
